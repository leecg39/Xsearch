{
  "manifest_version": 3,
  "name": "Xsearch",
  "version": "4.9.0",
  "description": "Xsearch — x.com 피드를 자동 스크롤하며 게시물을 수집해 CSV/JSON 저장, AI 브리핑까지 내보냅니다.",
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_title": "Xsearch 시작",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "permissions": ["scripting", "storage", "downloads"],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "https://news.soverin.cloud/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["bridge.js"],
      "run_at": "document_idle"
    }
  ]
}
